#!/bin/bash
#SBATCH --job-name=data_staging
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --time=00:10:00
#SBATCH --output=data_staging_%j.out

# SBATCH directives apply only when submitted with sbatch.

SCRIPT_NAME=${0##*/}

show_usage() {
    echo "Usage: $SCRIPT_NAME SOURCE DESTINATION"
    echo "Example: $SCRIPT_NAME /path/to/source /path/to/destination/"
    exit 1
}

# Ensure the script is running as a Slurm job on a worker node.
if [[ -z $SLURM_NODELIST ]]; then
    echo "ERROR: This script must not be run on a login node."
    exit 1
fi

if [[ $# -ne 2 ]]; then
    echo "ERROR: Two arguments are required."
    show_usage
fi

SOURCE=$1
DESTINATION=$2
RSYNC_OPTIONS=(-avp --partial-dir=.rsync-partial)

if [[ $DESTINATION == /shared* ]]; then
    # ACL-controlled shared areas do not support normal Linux ownership.
    RSYNC_OPTIONS+=(--no-perms --no-group)
    SHARED=$DESTINATION
else
    SHARED=$SOURCE
fi

# Extract the shared-area mount point, for example /shared/project_name.
SHARED=$(echo "$SHARED" | cut -d/ -f1-3)

SSH_OPTIONS=(
    -o BatchMode=yes
    -o ConnectTimeout=10
    -o ServerAliveInterval=10
    -o ServerAliveCountMax=3
)

check_login_node() {
    local login_node=$1

    ssh -q "${SSH_OPTIONS[@]}" "$login_node" exit
}

check_shared_area() {
    local login_node=$1
    local shared_real
    local shared_quoted
    local shared_real_quoted

    printf -v shared_quoted '%q' "$SHARED"

    shared_real=$(
        ssh -q "${SSH_OPTIONS[@]}" "$login_node" \
            "readlink -f -- $shared_quoted"
    ) || return 1

    [[ -n $shared_real ]] || return 1

    printf -v shared_real_quoted '%q' "$shared_real"

    ssh -q "${SSH_OPTIONS[@]}" "$login_node" \
        "mountpoint -q -- $shared_real_quoted"
}

# Safely quote the rsync command for execution on a login node.
printf -v RSYNC_COMMAND '%q ' \
    rsync "${RSYNC_OPTIONS[@]}" "$SOURCE" "$DESTINATION"

# Randomise the initial login node, then alternate nodes after failures.
mapfile -t login_nodes < <(shuf -e logina loginb)

retries=0
max_retries=3
retry_delay=10

while (( retries < max_retries )); do
    login_node=${login_nodes[$((retries % ${#login_nodes[@]}))]}

    echo "Attempt $((retries + 1)) of $max_retries using $login_node."

    if check_login_node "$login_node" &&
       check_shared_area "$login_node" &&
       ssh "${SSH_OPTIONS[@]}" "$login_node" "$RSYNC_COMMAND"; then
        echo "Rsync completed successfully using $login_node."
        exit 0
    fi

    echo "Transfer through $login_node failed."
    ((retries++))

    if (( retries < max_retries )); then
        echo "Retrying through the other login node in $retry_delay seconds."
        sleep "$retry_delay"
    fi
done

echo "ERROR: Rsync failed after $max_retries attempts."
exit 1
